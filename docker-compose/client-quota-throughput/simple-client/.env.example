# Image versions - the only values docker-compose.yml actually reads from
# this file. kafka_per_entity_quota_metrics requires Redpanda v26.2.1 or
# later. Every other setting in this lab (topic name, record size, client
# ID, quota value) is passed as an explicit CLI flag in the README commands,
# not read from the environment.
REDPANDA_VERSION=v26.2.1
REDPANDA_CONSOLE_VERSION=v3.3.1
