# Image versions. kafka_per_entity_quota_metrics and `rpk cluster loggers set`
# both require Redpanda v26.2.1 or later.
REDPANDA_VERSION=v26.2.1
REDPANDA_CONSOLE_VERSION=v3.3.1

TOPIC_NAME=quota-demo
RECORD_SIZE_BYTES=1700

# Must match the properties.client.id.prefix used in sql/run-client-id-prefix.sql
FLINK_CLIENT_ID_PREFIX=flink-quota-demo

# Quota value in bytes/sec, applied with --name client-id-prefix=$FLINK_CLIENT_ID_PREFIX
CONSUMER_QUOTA_BYTES_PER_SEC=10000
