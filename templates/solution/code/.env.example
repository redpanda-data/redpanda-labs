# Copied to .env by `make up` when .env does not exist. .env is git-ignored.
#
# Pin these to the versions you tested against before setting the solution to
# published. The nightly CI run overrides both with `latest` to catch drift.
REDPANDA_VERSION=latest
REDPANDA_CONSOLE_VERSION=latest

# Host ports. Change them when another stack already uses the defaults.
CONSOLE_PORT=8080
REDPANDA_KAFKA_PORT=19092
REDPANDA_SR_PORT=18081
REDPANDA_PROXY_PORT=18082
REDPANDA_ADMIN_PORT=19644
