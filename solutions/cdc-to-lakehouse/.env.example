# Copied to .env by `make up` when .env does not exist. .env is git-ignored.
#
# Image versions. Pinned to the releases this solution was tested against;
# the nightly CI run overrides them with `latest` to catch drift.
# Iceberg topics in `value_schema_latest` mode with a JSON schema need
# Redpanda v25.2 or later.
REDPANDA_VERSION=v26.2.2
REDPANDA_CONSOLE_VERSION=v3.11.0
REDPANDA_CONNECT_VERSION=4.108.0
POSTGRES_VERSION=16
MYSQL_VERSION=8.0
# MinIO's images moved off Docker Hub: they are on quay.io now.
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MINIO_MC_VERSION=RELEASE.2025-08-13T08-35-41Z
ICEBERG_REST_VERSION=1.9.2
SPARK_VERSION=3.5.7
ICEBERG_SPARK_VERSION=1.9.2

# Redpanda Connect's change data capture inputs (`postgres_cdc` and
# `mysql_cdc`) are enterprise features. A new Redpanda cluster starts with a
# 30-day trial license of its own, which covers Iceberg topics and Tiered
# Storage, but Redpanda Connect reads its license from here. Paste a trial or
# Enterprise Edition license key on the next line before you run the CDC
# steps. Leave it empty to run the Iceberg half of the solution only.
REDPANDA_LICENSE=

# Host ports. Change them when another stack already uses the defaults. The
# pages and the Doc Detective specs use these defaults; substitute yours.
CONSOLE_PORT=8480
REDPANDA_KAFKA_PORT=64092
REDPANDA_SR_PORT=64081
REDPANDA_ADMIN_PORT=64644
POSTGRES_PORT=5433
MYSQL_PORT=3307
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
ICEBERG_REST_PORT=8581
SPARK_UI_PORT=4041
CONNECT_PORT=4196

# The object store that holds both the Tiered Storage data and the Iceberg
# table files. Local credentials only: never reuse them anywhere.
MINIO_BUCKET=redpanda
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123

# The source databases. Local credentials only.
POSTGRES_DB=pandashop
POSTGRES_USER=pandashop
POSTGRES_PASSWORD=pandashop
MYSQL_DATABASE=pandashop
MYSQL_USER=pandashop
MYSQL_PASSWORD=pandashop
MYSQL_ROOT_PASSWORD=pandashop-root

# Spark is capped at 1 GB of driver heap: the queries in this solution read a
# handful of Parquet files.
SPARK_DRIVER_MEMORY=1g
