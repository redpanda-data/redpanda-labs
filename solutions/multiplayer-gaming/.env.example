# Copied to .env by `make up` when .env does not exist. .env is git-ignored.
#
# Image versions. Pinned to the releases this solution was tested against;
# the nightly CI run overrides them with `latest` to catch drift.
REDPANDA_VERSION=v26.2.2
REDPANDA_CONSOLE_VERSION=v3.11.0
REDPANDA_CONNECT_VERSION=4.109.0

# Host ports. Change them when another stack already uses the defaults. The
# pages and the Doc Detective specs use these defaults; substitute yours.
CONSOLE_PORT=8080
REDPANDA_KAFKA_PORT=19092
REDPANDA_SR_PORT=18081
REDPANDA_PROXY_PORT=18082
REDPANDA_ADMIN_PORT=19644
POSTGRES_PORT=15432
CONNECT_PORT=4195
SIMULATOR_PORT=8090
LEADERBOARD_PORT=3000
ACHIEVEMENTS_PORT=3010

# Postgres credentials. Only the compose stack reads them (Postgres itself and
# the Redpanda Connect pipeline's DSN).
POSTGRES_USER=game
POSTGRES_PASSWORD=game-dev-only
POSTGRES_DB=game

# Simulator. Same seed, same events, so counts below are exact.
SIM_SEED=42
SIM_PLAYERS=24
# Events per second while seeding. 3000 events at 100/s takes 30 seconds.
SIM_RATE=100
# Simulated match length in seconds (the generator keeps its own clock).
SIM_MATCH_DURATION=60
# Stop after exactly this many events. POST /burst produces more on demand.
SIM_EVENTS_MAX=3000
SIM_REGION=eu-west
