{
  "specId": "start-environment",
  "description": "Replays the Verify section of the 'start-environment' page: every container is healthy and the simulator waits for topics.",
  "contentPath": "docs/modules/multiplayer-gaming/pages/start-environment.adoc",
  "tests": [
    {
      "testId": "start-environment",
      "description": "Stack is up and the simulator refuses to produce before the topics exist",
      "steps": [
        {
          "runShell": {
            "command": "make up",
            "timeout": 600000
          }
        },
        {
          "runShell": {
            "command": "docker compose ps --format '{{.Service}} {{.Health}}'",
            "timeout": 60000,
            "stdio": "/simulator healthy/"
          }
        },
        {
          "runShell": {
            "command": "curl -s http://localhost:8090/stats | grep state",
            "timeout": 60000,
            "stdio": "/\"state\": \"waiting_for_topics\"/"
          }
        }
      ]
    }
  ]
}
