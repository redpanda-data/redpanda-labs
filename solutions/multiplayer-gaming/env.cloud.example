# The connection lines to change in .env for a Redpanda Cloud Serverless
# cluster (step 1, "Redpanda Cloud Serverless" tab). Copy .env.example to
# .env first, then replace these lines; everything else stays as it is.
COMPOSE_PROFILES=
REDPANDA_BROKERS=<bootstrap-server-url>
REDPANDA_TLS_ENABLED=true
REDPANDA_SASL_MECHANISM=SCRAM-SHA-256
REDPANDA_SASL_USERNAME=<user>
REDPANDA_SASL_PASSWORD=<password>
REDPANDA_SCHEMA_REGISTRY_URL=<schema-registry-url>
REDPANDA_TOPIC_REPLICAS=3
