# Copied to .env by `make up` when .env does not exist. .env is git-ignored.
#
# Image versions. Pinned to the releases this solution was tested against;
# the nightly CI run overrides them with `latest` to catch drift.
REDPANDA_VERSION=v26.2.2
REDPANDA_CONSOLE_VERSION=v3.11.0
REDPANDA_CONNECT_VERSION=4.109.0

# Connection. The defaults are the local broker started by this compose file.
# To run the same stack against Redpanda Cloud Serverless (step 1, the
# "Redpanda Cloud Serverless" tab): set COMPOSE_PROFILES to empty so the local
# redpanda and console containers are skipped, paste the bootstrap server URL
# and the Schema Registry URL from the cluster's Overview page, enable TLS,
# and fill in the SCRAM user you created. Every service, the rpk helper, and
# the Connect pipeline read these same variables.
COMPOSE_PROFILES=local
REDPANDA_BROKERS=redpanda:9092
REDPANDA_TLS_ENABLED=false
# SCRAM-SHA-256 for Redpanda Cloud; leave empty for the local broker.
REDPANDA_SASL_MECHANISM=
REDPANDA_SASL_USERNAME=
REDPANDA_SASL_PASSWORD=
REDPANDA_SCHEMA_REGISTRY_URL=http://redpanda:8081
# Schema Registry basic auth. Defaults to the SASL user, which is what
# Redpanda Cloud expects; set these only when the registry has its own user.
REDPANDA_SCHEMA_REGISTRY_USERNAME=
REDPANDA_SCHEMA_REGISTRY_PASSWORD=
# Replication factor `make topics` uses: 1 for the single local broker, 3 on
# Redpanda Cloud.
REDPANDA_TOPIC_REPLICAS=1

# Host ports. Change them when another stack already uses the defaults. The
# pages and the Doc Detective specs use these defaults; substitute yours.
CONSOLE_PORT=8080
REDPANDA_KAFKA_PORT=19092
REDPANDA_SR_PORT=18081
REDPANDA_PROXY_PORT=18082
REDPANDA_ADMIN_PORT=19644
POSTGRES_PORT=15432
CONNECT_PORT=4195
FEED_PORT=8090
MARKET_STATE_PORT=3010

# Postgres. Local only: the archive is a store for the walkthrough, not a
# production database. Change the password if you like; nothing reads it but
# this stack.
POSTGRES_USER=sports
POSTGRES_PASSWORD=sports-dev-only
POSTGRES_DB=sports

# The feed. A provider's push feed is bursty and finite: these values give a
# run that finishes in about a minute and produces the same events every time.
# FEED_SEED fixes the sequence, so two runs of the walkthrough show the same
# numbers.
FEED_SEED=42
# Events per second across every fixture. 200 is enough to see percentiles
# move without a laptop fan.
FEED_RATE=200
# How many events one fixture produces before the match ends. Four fixtures at
# 250 is a 1000 event run, which takes about five seconds at FEED_RATE=200 and
# gives the odds engine enough samples for a 99th percentile to mean something.
FEED_EVENTS_PER_FIXTURE=250
# A safety net, not the normal stopping condition: the run ends when every
# fixture has ended. Lower it to cut a run short.
FEED_EVENTS_MAX=4000
# Suspend or resume a market on every Nth event of a fixture. Suspension is
# what makes the odds engine hold a price instead of publishing one.
FEED_SUSPEND_EVERY=11
# Drop every Nth event before sending it, so the provider's sequence has holes
# in it and the market-state service reports gaps. 0 for a clean feed; the
# "when the feed lies" section of the last step turns it on.
FEED_DROP_EVERY=0
# The name the v2 schema records for each event. A second provider is the
# reason that field exists.
FEED_PROVIDER=sportradar

# Which feed schema the producer writes. `make evolve` overrides this with the
# v2 file; nothing else needs to change for the topic to hold both versions.
FEED_SCHEMA_FILE=/schemas/feed_event.avsc

# The latency budget scripts/verify.sh gates on, at the 99th percentile, from
# the provider's emit time to the published price. Raise it for a Cloud run:
# the consumers are the same but the round trip is not.
LATENCY_BUDGET_MS=1000
