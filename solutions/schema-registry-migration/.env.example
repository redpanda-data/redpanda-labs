# Copied to .env by `make up` when .env does not exist. .env is git-ignored.
#
# Image versions. Pinned to the releases this solution was tested against;
# the nightly CI run overrides them with `latest` to catch drift.
# API-mode Schema Registry replication (shadow_schema_registry_api) needs
# Redpanda v26.2 or later.
REDPANDA_VERSION=v26.2.2
REDPANDA_CONSOLE_VERSION=v3.11.0
CONFLUENT_VERSION=8.3.0

# Host ports. Change them when another stack already uses the defaults. The
# pages and the Doc Detective specs use these defaults; substitute yours.
# The Redpanda shadow cluster (the migration destination):
CONSOLE_PORT=8180
REDPANDA_KAFKA_PORT=29092
REDPANDA_SR_PORT=28081
REDPANDA_ADMIN_PORT=29644
# The Confluent source:
CONFLUENT_KAFKA_PORT=39092
CONFLUENT_SR_PORT=38081

# The shadow link. The name is what every rpk shadow command takes.
SHADOW_LINK=schema-registry-migration

# JVM heap for the two Confluent containers. Small on purpose: this is a
# single-node source with a handful of schemas and records.
KAFKA_HEAP_OPTS="-Xmx512M -Xms256M"
SCHEMA_REGISTRY_HEAP_OPTS="-Xmx256M"
