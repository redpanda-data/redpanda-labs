# Copied to .env by `make up` when .env does not exist. .env is git-ignored.
#
# Image versions. Pinned to the releases this solution was tested against;
# the nightly CI run overrides them with `latest` to catch drift.
REDPANDA_VERSION=v26.2.2
REDPANDA_CONSOLE_VERSION=v3.11.0
REDPANDA_CONNECT_VERSION=4.109.0

# Host ports. Change them when another stack already uses the defaults. The
# pages use these defaults; substitute yours.
CONSOLE_PORT=8280
CONSOLE_SOURCE_PORT=8281
SOURCE_KAFKA_PORT=49092
SOURCE_SR_PORT=48081
SOURCE_ADMIN_PORT=49644
TARGET_KAFKA_PORT=59092
TARGET_SR_PORT=58081
TARGET_ADMIN_PORT=59644
MIGRATOR_PORT=4295

# Credentials. Both clusters start with SASL/SCRAM on and one bootstrap
# superuser. Every client reads them from here; no page carries them.
ADMIN_USER=admin
ADMIN_PASSWORD=admin-dev-only
# Created by `make migrator-access` with least-privilege ACLs on each cluster.
MIGRATOR_USER=migrator
MIGRATOR_PASSWORD=migrator-dev-only

# The legacy application: one Avro record every PRODUCER_INTERVAL. Records
# are spaced far enough apart that every record on a partition has its own
# timestamp, which is what makes the consumer offset translation exact here.
PRODUCER_INTERVAL=20ms

# Redpanda Migrator sync intervals, short so the walkthrough shows results in
# seconds. The component defaults are 5m (schemas) and 1m (consumer groups).
SCHEMA_SYNC_INTERVAL=10s
OFFSET_SYNC_INTERVAL=10s
