# Copied to .env by `make up` when .env does not exist. .env is git-ignored.
#
# Image versions. Pinned to the releases this solution was tested against;
# the nightly CI run overrides them with `latest` to catch drift.
# Shadowing needs Redpanda v25.3 or later. Envoy needs a `contrib` image: the
# Kafka broker filter is not in the standard build.
REDPANDA_VERSION=v26.2.2
REDPANDA_CONSOLE_VERSION=v3.11.0
ENVOY_VERSION=contrib-v1.31-latest

# Host ports. Change them when another stack already uses the defaults. The
# pages and the Doc Detective specs use these defaults; substitute yours.
# Envoy, the only endpoint clients are given:
ENVOY_KAFKA_PORT=60092
ENVOY_ADMIN_PORT=60901
# The source cluster (direct access, for the walkthrough and for Console):
SOURCE_KAFKA_PORT=63092
SOURCE_SR_PORT=63081
SOURCE_ADMIN_PORT=63644
# The shadow cluster (the failover target):
SHADOW_KAFKA_PORT=61092
SHADOW_SR_PORT=61081
SHADOW_ADMIN_PORT=61644
# One Console per cluster, so you can watch replication from both sides:
SOURCE_CONSOLE_PORT=8380
SHADOW_CONSOLE_PORT=8381

# The shadow link. The name is what every `rpk shadow` command takes.
SHADOW_LINK=disaster-recovery-shadowing

# The workload. The topic filter in config/shadow-link.yaml matches the `dr-`
# prefix, so a topic outside it is not replicated.
DR_TOPIC=dr-orders
DR_PARTITIONS=3
DR_GROUP=dr-consumers
