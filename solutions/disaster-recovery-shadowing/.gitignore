# Facts the walkthrough records as it runs, asserted later by scripts/verify.sh.
state/*.json

# `make up` writes its build progress to stdout, so tools/capture-expected.sh
# records it. No page includes it, and the image digest in it changes whenever
# the client image is rebuilt.
steps/start-environment/expected/up.txt

# The pid file the Kubernetes step has the reader write for its two
# `kubectl port-forward` jobs. The last instruction of that step deletes it.
local-port-forward.pid
